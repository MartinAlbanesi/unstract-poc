# Copy to deployments/.env (gitignored) and fill in real values.
# API keys are generated per deployment in Prompt Studio -> API Deployments -> Manage Keys.
# LLM/OCR provider keys are configured as adapters in the Prompt Studio UI directly
# (never stored in a file) - listed here only as a reminder of what's needed.

UNSTRACT_BASE_URL=http://frontend.unstract.localhost
UNSTRACT_ORG=mock_org

FACTURA_API_NAME=factura
FACTURA_API_KEY=

REMITO_API_NAME=remito
REMITO_API_KEY=

CARTA_DE_PORTE_API_NAME=carta-porte
CARTA_DE_PORTE_API_KEY=

# Reminder only - entered via adapter forms in the UI, not read from here:
# GOOGLE_AI_STUDIO_API_KEY=   (Gemini LLM + embedding adapters)
# LLMWHISPERER_API_KEY=     (Text Extractor adapter - 100 pages/day free tier)